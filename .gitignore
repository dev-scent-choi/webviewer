# 의존성
node_modules/

# 업로드된 문서·변환본·감사 로그 (사용자 데이터 — 절대 커밋 금지)
data/

# 외부 변환 도구 바이너리 (README의 설치 안내 참조) — 단 아트크래프트 껍데기 크레이트(소스)는 저장소에 둔다
# (어느 깊이의 tools/든 무시 — 단 맨 위 tools/는 열어 두고 그 안에서 artcraft-shell만, 그 아래 하위 폴더는 통째로 포함)
**/tools/
!/tools/
/tools/*
!/tools/artcraft-shell/
/tools/artcraft-shell/.build/
!/tools/artcraft-app/
/tools/artcraft-app/.build/

# 로그·임시 파일
*.log
.DS_Store
Thumbs.db

# 도구 캐시(소스 아님)
.impeccable/

# 빌드 산출물 (src/client/*.ts에서 npm run build:editor로 생성됨)
public/js/editor.bundle.js
public/js/editor.bundle.js.map
public/js/grid-editor.bundle.js
public/js/grid-editor.bundle.js.map
public/js/editor-slides.bundle.js
public/js/editor-slides.bundle.js.map
public/js/editor-hwp.bundle.js
public/js/editor-hwp.bundle.js.map
public/js/editor-pdf.bundle.js
public/js/editor-pdf.bundle.js.map
public/js/view.bundle.js
public/js/view.bundle.js.map
public/js/artcraftWorker.bundle.js
public/js/artcraftWorker.bundle.js.map
public/js/artcraftApp.bundle.js
public/js/artcraftApp.bundle.js.map
public/js/artcraftFrame.bundle.js
public/js/artcraftFrame.bundle.js.map
# PDF 편집기의 pdf.js 부속(build-editor.mjs가 node_modules/pdfjs-dist에서 복사)
public/js/pdf.worker.mjs
public/pdfjs/
# PDF 편집기 OCR 부속(build-editor.mjs가 tesseract.js에서 복사)
public/ocr/
# splitting:true가 뽑아내는 공유 chunk(prosemirror/yjs 등 여러 편집기가 겹쳐 쓰는 코드) — 파일명이
# 빌드마다 content-hash로 바뀌어 소스가 아니다.
public/js/chunks/

# 외부 프로젝트(@rhwp/editor의 rhwp-studio) 미러 — tools/와 같은 이유로 커밋하지 않는다.
# node scripts/mirror-rhwp-studio.mjs로 받는다(README "한글(hwp/hwpx) 편집" 참고).
public/rhwp/

# 브라우저 회귀 테스트 산출물(스크린샷·샘플 업로드 파일) — 실행할 때마다 재생성됨
scripts/.screenshots/

# 운영 비밀값(DOCVIEW_SECRET/DOCVIEW_API_KEYS) — start.bat이 존재하면 불러온다.
# start.local.bat.example을 이 이름으로 복사해서 실제 값을 채운다(README "운영 실행" 참고).
# 이 파일 자체가 없으면(로컬 개발 등) start.bat이 경고만 남기고 임시 시크릿으로 계속 동작한다.
start.local.bat

# Claude Code 개인용 로컬 설정(권한 등) — 팀과 공유하지 않는다.
.claude/settings.local.json

# `npm pack`/`npm publish` 산출물 — 배포 전 로컬 검증용으로 그때그때 만드는 tarball, 소스 아님.
*.tgz

# npm 배포용 서버 컴파일 산출물(scripts/build-server.mjs → package.json의 prepack이 생성) — 소스 아님.
dist/
public/js/.build.lock

# 아트크래프트 브라우저 엔진 산출물(npm run build:artcraft) — 이름에 내용 해시가 붙어 소스가 아니다
public/artcraft/
# 아트크래프트 앱 화면 산출물(npm run build:artcraft-app) — 폴더 이름에 내용 해시
public/artcraft-app/

# 품질 점검(audit:office) 실행 산출물 — 서버 데이터·임시 폴더·그림
.audit-run/
docs/quality-audit/out/
audit/office/corpus/raw/
